# Required for a GitHub webhook endpoint.
OSG_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Keep disabled until a maintainer has reviewed the local dry-run.
OSG_AUTONOMY_ENABLED=0
# skip | local | docker
OSG_AUTONOMY_EXECUTE=skip
# A token is only read when a remote Draft PR is explicitly enabled.
OSG_GITHUB_TOKEN=
OSG_REMOTE_WRITE=0
OSG_DATABASE=runtime/opensourceguard.sqlite3
# Optional OpenAI-compatible model endpoint. Leave blank for local-only analysis.
OSG_AGENT_BASE_URL=
OSG_AGENT_API_KEY=
OSG_AGENT_MODEL=
# Local one-click install stays disabled unless explicitly enabled.
OSG_DEPLOY_ENABLE=0
OSG_REPO_ROOT=.
# Optional OpenViking context database (long-term memory for the Agent).
# Leave blank to disable; resource/memory write APIs degrade to a notice.
OSG_OPENVIKING_URL=
OSG_OPENVIKING_API_KEY=
